package layout

templ Layout(component templ.Component) {
    <!DOCTYPE html>
    <html lang="en" class="dark">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <link rel="stylesheet" href="static/styles/output.css">       
            <script src="https://unpkg.com/htmx.org@2.0.4"></script>
            <script src="static/js/htmx_config.js"></script>
            <title>Your Page Title</title>
        </head>
        <body class="container flex bg-bg-tertiary text-text-primary">
            <div id="container" class="grow">
                @component
            </div>
        </body>
    </html>
}
